<section class="admin-news-section">
    <div class="py-5">
        <div class="container">
            <h2 class="admin-title">{{#if editNews}}Редактирование новости{{else}}Добавление новости{{/if}}</h2>

            <form action="{{#if editNews}}/admin/update-news/{{editNews.news_id}}{{else}}/admin/add-news{{/if}}" method="POST" enctype="multipart/form-data" class="news-form"> 
                <div class="form-group">
                    <label for="title">Заголовок:</label>
                    <input type="text" id="title" name="title" placeholder="Введите заголовок"
                    value="{{#if editNews}}{{editNews.title_news}}{{/if}}"
                    required>
                </div>

                <div class="form-group">
                    <label for="description">Описание:</label>
                    <textarea id="description" name="description" placeholder="Введите описание" rows="4" required
                    >{{#if editNews}}{{editNews.description_news}}{{/if}}</textarea>
                </div>

                <div class="form-group">
                    <label for="bookingDate">Дата:</label>
                    <input type="date" id="bookingDate" name="bookingDate"
                    value="{{#if editNews}}{{editNews.create_date}}{{/if}}"
                    required>
                </div>

                <div class="form-group">
                    <label for="photo">Фотография:</label>
                    <input class="photo-input" type="file" id="photo" name="photo" accept="image/png, image/jpeg" required>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" class="create-btn">
                        {{#if editNews}}Редактировать новость{{else}}Создать новость{{/if}}
                    </button>
                    <a href="/admin/content" class="btn btn-primary">Вернуться назад</a>
                </div>
            </form>

            <h2 class="admin-title mt-5">Существующие новости</h2>
            <table class="news-table">
                <thead>
                    <tr>
                        <th>Заголовок</th>
                        <th>Описание</th>
                        <th>Фотография</th>
                        <th>Дата</th>
                        <th>Изменить</th>
                        <th>Удалить</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each newsList}}
                        <tr>
                            <td style="width: 20%; max-width: 200px;">{{this.title_news}}</td>
                            <td style="width: 40%; max-width: 500px; word-wrap: break-word;">
                            <div class="description-container">
                                <div class="description-text truncated-description" id="desc-{{this.news_id}}">
                                {{this.description_news}}
                                </div>
                                <button class="toggle-btn" data-id="{{this.news_id}}">Смотреть далее</button>
                            </div>
                            </td>
                            <td><small>{{this.image_news}}</small></td>
                            <td>{{this.create_date}}</td>
                            <td>
                                <form method="GET" action="/admin/admin-news/edit/{{this.news_id}}">
                                    <button type="submit" class="edit-btn">Изменить</button>
                                </form>
                            </td>
                            <td>
                                <form method="POST" action="/admin/delete-news/{{this.news_id}}">
                                    <button type="submit" class="delete-btn">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('.toggle-btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', function () {
        const id = this.dataset.id;
        const desc = document.getElementById(`desc-${id}`);

        desc.classList.toggle('truncated-description');

        if (desc.classList.contains('truncated-description')) {
          this.textContent = 'Смотреть далее';
        } else {
          this.textContent = 'Скрыть';
        }
      });
    });
  });
</script>
